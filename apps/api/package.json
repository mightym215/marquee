{
  "name": "@marquee/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "eval": "tsx --env-file-if-exists=../../.env src/eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@marquee/tmdb-mcp": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
