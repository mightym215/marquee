# Copy to .env and fill in. Never commit .env.

# Required: free at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the longer "API Read Access Token" works.
TMDB_API_KEY=

# Optional: turns on the AI concierge. https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
# TMDB_REGION=US              # country for now playing and where to watch
# The concierge is the only part that costs money. Defaults:
# CONCIERGE_DAILY_LIMIT=30          # whole site, per day
# CONCIERGE_PER_VISITOR_DAILY=8     # each visitor, per day
# CONCIERGE_PER_MINUTE=4            # each visitor, per minute
# MARQUEE_DEMO=1              # sample data, no TMDB key needed
# PORT=8787
